---
// Inline SVG sparkline of daily values; no chart library, no JavaScript.
import { date } from "../i18n/format";
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  name: string;
  values: (number | null)[];
  dates: string[];
}

const { locale, name, values, dates } = Astro.props;
const width = 96;
const height = 28;
const pad = 3;

const points = values
  .map((v, i) => (v === null ? null : { i, v }))
  .filter((p): p is { i: number; v: number } => p !== null);

let path = "";
let last: { x: number; y: number } | null = null;
let direction: "up" | "down" | "flat" = "flat";
if (points.length >= 2) {
  const min = Math.min(...points.map((p) => p.v));
  const max = Math.max(...points.map((p) => p.v));
  const span = max - min || 1;
  const step = (width - pad * 2) / Math.max(values.length - 1, 1);
  const coords = points.map((p) => ({
    x: pad + p.i * step,
    // Flat series sit in the middle rather than on the floor.
    y: max === min ? height / 2 : pad + (1 - (p.v - min) / span) * (height - pad * 2),
  }));
  path = coords.map((c, i) => `${i === 0 ? "M" : "L"}${c.x.toFixed(1)} ${c.y.toFixed(1)}`).join(" ");
  last = coords.at(-1)!;
  const delta = points.at(-1)!.v - points[0]!.v;
  direction = Math.abs(delta) < 0.005 ? "flat" : delta > 0 ? "up" : "down";
}
const stroke = direction === "down" ? "#c8102e" : "#00704f";
const firstDate = dates[points[0]?.i ?? 0];
const lastDate = dates[points.at(-1)?.i ?? 0];
---

{
  points.length >= 2 ? (
    <svg
      width={width}
      height={height}
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-label={t(locale, "trend.label", {
        name,
        n: points.length,
        first: firstDate ? date(locale, firstDate) : "",
        last: lastDate ? date(locale, lastDate) : "",
      })}
      class="block"
    >
      <path d={path} fill="none" stroke={stroke} stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round" />
      {last && <circle cx={last.x} cy={last.y} r="2.25" fill={stroke} />}
    </svg>
  ) : (
    <span class="text-xs text-slate-600">{t(locale, "trend.none")}</span>
  )
}
