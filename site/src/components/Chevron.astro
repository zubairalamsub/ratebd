---
// Disclosure chevron; turns when the closest .group <details> is open.
interface Props {
  /** Colour class; defaults to muted slate */
  tone?: string;
}

const { tone = "text-slate-600" } = Astro.props;
---

<svg
  viewBox="0 0 20 20"
  class:list={["h-5 w-5 shrink-0 transition-transform group-open:rotate-180 motion-reduce:transition-none", tone]}
  aria-hidden="true"
>
  <path
    fill="currentColor"
    d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06z"
  ></path>
</svg>
