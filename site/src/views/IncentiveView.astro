      tbs20261013: "দ্য বিজনেস স্ট্যান্ডার্ড (১৩ অক্টো ২০২৬): প্রবাসী কার্ডধারীরা পাবেন ৩%",
      ds20261013: "দ্য ডেইলি স্টার (১৩ অক্টো ২০২৬): প্রবাসী কার্ডের পরীক্ষামূলক কার্যক্রম",
      imf2026: "আইএমএফ কান্ট্রি রিপোর্ট নং ২৬/২৪ (জানু ২০২৬), অনুচ্ছেদ ২২",
    },
    checked: (d) => `${d} তারিখে এসব সূত্রের সঙ্গে তথ্য যাচাই করা হয়েছে। বাংলাদেশ ব্যাংকের সার্কুলারই চূড়ান্ত; নিয়ম বদলাতে পারে।`,
    sourceLabel: "সূত্র",
    faq: [
      {
        q: "বাংলাদেশে রেমিট্যান্স প্রণোদনা কত?",
        a: "বৈধ পথে পাঠানো প্রবাসী আয়ের টাকার অঙ্কের ২.৫%, ১ জানুয়ারি ২০২২ থেকে কার্যকর এবং ২০২৬-২৭ বাজেটে বহাল।",
      },
      {
        q: "রেমিট্যান্স প্রণোদনা কে পান?",
        a: "বাংলাদেশে প্রাপক। আহরণকারী ব্যাংক প্রাপকের হিসাবে জমা বা পরিশোধের সময় এটি যোগ করে।",
      },
      {
        q: "প্রণোদনা পেতে কি কাগজপত্র লাগে?",
        a: "না। ২৩ মে ২০২২ থেকে বাংলাদেশ ব্যাংক প্রেরকের কাছ থেকে কোনো কাগজপত্র চায় না।",
      },
    ],
  },
};

const c = content[locale];
const title = t(locale, "incentive.title");
const description = t(locale, "incentive.description");
const corridor = CORRIDORS[0]!;
const best = rowsFor(corridor.id, 1000).find((r) => !r.quote.stale);
const exampleText = best
  ? c.example({
      amount: sendAmount(locale, best.quote.sendAmount, corridor.sendCurrency),
      name: best.provider.name,
      receive: money(locale, best.quote.receiveAmount, "BDT"),
      bonus: money(locale, Math.round(best.quote.receiveAmount * RATE) / 100, "BDT"),
      total: money(locale, Math.round(best.quote.receiveAmount * (100 + RATE)) / 100, "BDT"),
    })
  : null;
const sourceKeys = Object.keys(S) as (keyof typeof S)[];
const sourceNumber = (key: keyof typeof S) => sourceKeys.indexOf(key) + 1;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: locale,
    mainEntity: c.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---

<BaseLayout locale={locale} title={title} description={description} path="/government-incentive" jsonLd={jsonLd}>
  <article class="prose-block max-w-3xl">
    <h1 class="text-2xl sm:text-3xl">{title}</h1>
    <p class="mt-4 text-lg">{c.lead}</p>

    <section class="mt-8" aria-labelledby="facts">
      <h2 id="facts" class="text-xl">{c.factsTitle}</h2>
      <dl class="mt-3 divide-y divide-slate-200 border-y border-slate-200">
        {
          c.facts.map((f) => (
            <div class="py-3 sm:grid sm:grid-cols-4 sm:gap-4">
              <dt class="font-semibold text-slate-900">{f.term}</dt>
              <dd class="mt-1 text-slate-700 sm:col-span-3 sm:mt-0">
                {f.text}{" "}
                {f.sources.map((key) => (
                  <a href={`#source-${sourceNumber(key)}`} class="text-sm">
                    [{c.sourceLabel} {sourceNumber(key)}]
                  </a>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-8" aria-labelledby="meaning">
      <h2 id="meaning" class="text-xl">{c.meaningTitle}</h2>
      <p class="mt-2">{c.meaning}</p>
      {exampleText && <p class="mt-3 rounded-lg border border-brand-100 bg-brand-50 p-4 tabular">{exampleText}</p>}
      <p class="mt-3">{c.qualifies}</p>
      <p class="mt-3">
        {
          CORRIDORS.map((x, i) => (
            <>
              {i > 0 && " · "}
              <a href={localePath(locale, corridorPath(x.from))}>{x.sendCurrency} → BDT</a>
            </>
          ))
        }
      </p>
    </section>

    <section class="mt-8" aria-labelledby="proposed">
      <h2 id="proposed" class="text-xl">{c.proposedTitle}</h2>
      <ul class="mt-2 list-disc space-y-2 pl-6">
        {
          c.proposed.map((p) => (
            <li>
              {p.text}{" "}
              {p.sources.map((key) => (
                <a href={`#source-${sourceNumber(key)}`} class="text-sm">
                  [{c.sourceLabel} {sourceNumber(key)}]
                </a>
              ))}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-10" aria-labelledby="faq">
      <h2 id="faq" class="text-xl">{t(locale, "faq.title")}</h2>
      <dl class="mt-3 divide-y divide-slate-200 border-y border-slate-200">
        {
          c.faq.map((f) => (
            <div class="py-3">
              <dt class="font-semibold text-slate-900">{f.q}</dt>
              <dd class="mt-1 text-slate-700">{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-10" aria-labelledby="sources">
      <h2 id="sources" class="text-xl">{c.sourcesTitle}</h2>
      <ol class="mt-3 list-decimal space-y-1 pl-6 text-sm">
        {
          sourceKeys.map((key) => (
            <li id={`source-${sourceNumber(key)}`}>
              <a href={S[key]} rel="noopener">{c.sourceNames[key]}</a>
            </li>
          ))
        }
      </ol>
      <p class="mt-4 text-sm text-slate-600">{c.checked(date(locale, FACTS_CHECKED))}</p>
    </section>
  </article>
</BaseLayout>
