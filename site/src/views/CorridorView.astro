---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostedRateTable from "../components/PostedRateTable.astro";
import RateTable from "../components/RateTable.astro";
import {
  BENCHMARK,
  CORRIDORS,
  PROVIDERS,
  amountsFor,
  benchmarkQuote,
  corridorByFrom,
  loadSnapshot,
  postedRowsFor,
  rowsFor,
  topRows,
  unavailable,
} from "../lib/data";
import { date, dateTime, list, money, number, rate, sendAmount } from "../i18n/format";
import { feeNote } from "../i18n/labels";
import { corridorPath, localePath } from "../i18n/routes";
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  from: string;
}

const { locale, from } = Astro.props;
const corridor = corridorByFrom(from);
const snapshot = loadSnapshot(corridor.id);
const mid = snapshot.midMarket;
const country = t(locale, corridor.countryKey);
const path = corridorPath(corridor.from);
const posted = postedRowsFor(corridor.id);
// A route is rate-only when every quoting provider reports it does not serve it (Oman today). A provider that merely
// failed doesn't make it so: the ranked table stays, with that provider listed as unavailable.
const rateOnly =
  posted.length > 0 && snapshot.providers.every((s) => s.name === BENCHMARK || s.status === "not_supported");
const amounts = rateOnly ? [] : amountsFor(corridor.id);
const tables = amounts.map((amount) => ({ amount, rows: rowsFor(corridor.id, amount) }));
const missing = unavailable(corridor.id);
const quotedNames = PROVIDERS.filter((p) => snapshot.quotes.some((q) => q.provider === p.engineName)).map((p) => p.name);
const postedNames = PROVIDERS.filter((p) => posted.some((r) => r.posted.provider === p.engineName)).map((p) => p.name);

const title = t(locale, "corridor.title", { country, from: corridor.sendCurrency });
// Only providers with quotes are said to give fees and taka received; exchange houses are named as posting rates.
const description =
  quotedNames.length === 0 && postedNames.length > 0
    ? t(locale, "corridor.descriptionPosted", { from: corridor.sendCurrency, providers: list(locale, postedNames) })
    : t(locale, "corridor.description", { from: corridor.sendCurrency, providers: list(locale, quotedNames) });
const amountId = (amount: number) => `amount-${corridor.from}-${amount}`;

// CSS-only amount switch: radio inputs carry amt-{index}; Tailwind needs these class names written out literally.
const TOGGLE_LABEL = [
  "group-has-[.amt-0:checked]:border-brand-700 group-has-[.amt-0:checked]:bg-brand-700 group-has-[.amt-0:checked]:text-white group-has-[.amt-0:focus-visible]:outline-2 group-has-[.amt-0:focus-visible]:outline-offset-2 group-has-[.amt-0:focus-visible]:outline-brand-700",
  "group-has-[.amt-1:checked]:border-brand-700 group-has-[.amt-1:checked]:bg-brand-700 group-has-[.amt-1:checked]:text-white group-has-[.amt-1:focus-visible]:outline-2 group-has-[.amt-1:focus-visible]:outline-offset-2 group-has-[.amt-1:focus-visible]:outline-brand-700",
];
// Without :has() support the first table stays visible, so the page never renders empty.
const TOGGLE_PANEL = ["group-has-[.amt-1:checked]:hidden", "hidden group-has-[.amt-1:checked]:block"];
if (amounts.length > TOGGLE_LABEL.length) {
  throw new Error("Add TOGGLE_LABEL/TOGGLE_PANEL classes for the extra send amount");
}

// FAQ content is rendered on the page and mirrored in FAQPage JSON-LD.
const headline = tables[0];
const headlineAmount = headline ? sendAmount(locale, headline.amount, corridor.sendCurrency) : "";
const top = headline ? topRows(headline.rows) : [];
const best = top[0] ?? headline?.rows[0];
// Tied rows are named together only when they are the same price (rate and fee), so the answer stays exact.
const bestNames =
  best && top.length > 1 && top.every((r) => r.quote.rate === best.quote.rate && r.quote.fee === best.quote.fee)
    ? list(locale, top.map((r) => r.provider.name))
    : best?.provider.name;
const bestPosted = posted.find((r) => !r.posted.stale) ?? posted[0];
const postedName = (r: (typeof posted)[number]) =>
  r.posted.partner ? `${r.posted.partner} (${t(locale, "posted.via", { name: r.provider.name })})` : r.provider.name;
const faqs = [
  ...(headline
    ? [
        {
          q: t(locale, "faq.best.q", { amount: headlineAmount }),
          a: best
            ? t(locale, "faq.best.a", {
                name: bestNames ?? best.provider.name,
                receive: money(locale, best.quote.receiveAmount, "BDT"),
                amount: headlineAmount,
                rate: rate(locale, best.quote.rate),
                fee: money(locale, best.quote.fee, corridor.sendCurrency),
                date: dateTime(locale, best.quote.fetchedAt),
              })
            : t(locale, "faq.best.none", { amount: headlineAmount }),
        },
      ]
    : []),
  ...(bestPosted
    ? [
        {
          q: t(locale, "faq.posted.q"),
          a: t(locale, bestPosted.posted.feeNote ? "faq.posted.aRange" : "faq.posted.a", {
            name: postedName(bestPosted),
            from: corridor.sendCurrency,
            rate: rate(locale, bestPosted.posted.rate),
            date: dateTime(locale, bestPosted.posted.fetchedAt),
            fee: bestPosted.posted.feeNote ? feeNote(locale, bestPosted.posted.feeNote) : "",
          }),
        },
      ]
    : []),
  { q: t(locale, "faq.mid.q"), a: t(locale, "faq.mid.a") },
  ...(rateOnly ? [] : [{ q: t(locale, "faq.margin.q"), a: t(locale, "faq.margin.a") }]),
  { q: t(locale, "faq.update.q"), a: t(locale, "faq.update.a") },
  { q: t(locale, "faq.incentive.q"), a: t(locale, "faq.incentive.a") },
];

const pageUrl = new URL(localePath(locale, path), Astro.site).href;
const jsonLd = [
  ...tables.map(({ amount }) => ({
    "@context": "https://schema.org",
    "@type": "Table",
    "@id": `${pageUrl}#${amountId(amount)}`,
    name: t(locale, "table.caption", {
      from: corridor.sendCurrency,
      amount: sendAmount(locale, amount, corridor.sendCurrency),
    }),
    about: title,
    inLanguage: locale,
    dateModified: snapshot.generatedAt,
  })),
  ...(posted.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "Table",
          "@id": `${pageUrl}#posted-heading`,
          name: t(locale, "posted.caption", { from: corridor.sendCurrency }),
          about: title,
          inLanguage: locale,
          dateModified: snapshot.generatedAt,
        },
      ]
    : []),
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: locale,
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<BaseLayout locale={locale} title={title} description={description} path={path} jsonLd={jsonLd}>
  <h1 class="text-2xl sm:text-3xl">
    {t(locale, "corridor.h1", { country })}
    <span class="mt-1 block text-lg font-medium text-slate-600">{corridor.sendCurrency} → BDT</span>
  </h1>
  <p class="mt-3 max-w-3xl text-slate-700">{rateOnly ? t(locale, "corridor.leadPosted", { country }) : t(locale, "corridor.lead")}</p>
  <nav aria-label={t(locale, "corridor.otherRoutes")} class="mt-4">
    <ul class="flex flex-wrap gap-2 text-sm">
      {
        CORRIDORS.map((c) => (
          <li>
            <a
              href={localePath(locale, corridorPath(c.from))}
              aria-current={c.id === corridor.id ? "page" : undefined}
              class:list={[
                "inline-flex min-h-11 items-center rounded-full border px-3 no-underline",
                c.id === corridor.id
                  ? "border-brand-700 bg-brand-700 font-semibold text-white"
                  : "border-slate-300 text-slate-800 hover:border-brand-700",
              ]}
            >
              {t(locale, c.countryKey)} · {c.sendCurrency}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <p class="mt-2 text-sm text-slate-600">
    <time datetime={snapshot.generatedAt}>{t(locale, "updated.label", { date: dateTime(locale, snapshot.generatedAt) })}</time>{locale === "bn" ? "।" : "."}
    {t(locale, "updated.schedule")}
  </p>

  <section aria-labelledby="mid-heading" class="mt-6 rounded-lg border border-brand-100 bg-brand-50 p-4">
    <h2 id="mid-heading" class="text-base">{t(locale, "mid.title")}</h2>
    {
      mid ? (
        <>
          <p class="mt-1 text-xl font-semibold text-brand-800 tabular">
            {t(locale, "mid.rate", { from: corridor.sendCurrency, rate: rate(locale, mid.rate) })}
          </p>
          <p class="mt-1 text-sm text-slate-700">
            {t(locale, "mid.explain", {
              usdBdt: rate(locale, mid.usdBdt),
              usdBdtDate: mid.usdBdtDate ? date(locale, mid.usdBdtDate) : "–",
              sendPerUsd: number(locale, mid.sendPerUsd, 4),
              from: corridor.sendCurrency,
              crossDate: mid.crossRateDate ? date(locale, mid.crossRateDate) : "–",
            })}
          </p>
          {mid.stale && (
            <p class="mt-1 text-sm font-medium text-amber-900">
              {t(locale, "mid.stale", { date: dateTime(locale, mid.fetchedAt) })}
            </p>
          )}
        </>
      ) : (
        <p class="mt-1 text-sm text-slate-700">{t(locale, "mid.unavailable")}</p>
      )
    }
  </section>

  {
    tables.length > 0 && (
      <div class="group mt-8">
        <fieldset class="flex flex-wrap items-center gap-2">
          <legend class="mb-2 w-full text-sm font-semibold text-slate-800">{t(locale, "corridor.amount")}</legend>
          {
            tables.map(({ amount }, i) => (
              <>
                <input type="radio" name={`amount-${corridor.from}`} id={amountId(amount)} class={`sr-only amt-${i}`} checked={i === 0} />
                <label
                  for={amountId(amount)}
                  class:list={[
                    "inline-flex min-h-11 cursor-pointer items-center rounded-full border border-slate-300 px-4 font-medium text-slate-800",
                    TOGGLE_LABEL[i],
                  ]}
                >
                  {sendAmount(locale, amount, corridor.sendCurrency)}
                </label>
              </>
            ))
          }
        </fieldset>

        {
          tables.map(({ amount, rows }, i) => {
            const bench = benchmarkQuote(corridor.id, amount);
            const visibility = TOGGLE_PANEL[i];
            return (
              <section id={`table-${amountId(amount)}`} class:list={["mt-4", visibility]} aria-labelledby={`h-${amountId(amount)}`}>
                <h2 id={`h-${amountId(amount)}`} class="sr-only">
                  {t(locale, "corridor.send", { amount: sendAmount(locale, amount, corridor.sendCurrency) })}
                </h2>
                <RateTable locale={locale} corridor={corridor} amount={amount} rows={rows} />
                {bench && (
                  <p class="mt-2 text-sm text-slate-600">
                    {t(locale, "mid.receive", {
                      amount: sendAmount(locale, amount, corridor.sendCurrency),
                      receive: money(locale, bench.receiveAmount, "BDT"),
                    })}
                  </p>
                )}
              </section>
            );
          })
        }
      </div>
    )
  }

  {
    posted.length > 0 && (
      <section aria-labelledby="posted-heading" class="mt-8">
        <h2 id="posted-heading" class="text-lg">{t(locale, "posted.title")}</h2>
        <p class="mt-1 max-w-3xl text-sm text-slate-700">{t(locale, "posted.lead")}</p>
        <div class="mt-3">
          <PostedRateTable locale={locale} corridor={corridor} amount={headline?.amount ?? amountsFor(corridor.id)[0]} rows={posted} />
        </div>
      </section>
    )
  }

  {
    missing.length > 0 && (
      <section aria-labelledby="unavailable-heading" class="mt-8">
        <h2 id="unavailable-heading" class="text-lg">{t(locale, "unavailable.title")}</h2>
        <ul class="mt-2 space-y-1 text-sm text-slate-700">
          {missing.map(({ provider, status }) => (
            <li>
              <a href={localePath(locale, `/providers/${provider.slug}`)} class="font-medium">{provider.name}</a>:{" "}
              {t(locale, status.status === "not_supported" ? "status.not_supported" : "status.failed")}
              {status.message && (
                <span class="text-slate-600" lang="en">
                  {" "}({status.message})
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section aria-labelledby="faq-heading" class="mt-10">
    <h2 id="faq-heading" class="text-xl">{t(locale, "faq.title")}</h2>
    <dl class="mt-3 divide-y divide-slate-200 border-y border-slate-200">
      {
        faqs.map((f) => (
          <div class="py-3">
            <dt class="font-semibold text-slate-900">{f.q}</dt>
            <dd class="mt-1 text-slate-700">
              {f.a}
              {f.q === t(locale, "faq.incentive.q") && (
                <>
                  {" "}
                  <a href={localePath(locale, "/government-incentive")}>{t(locale, "nav.incentive")}</a>
                </>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <p class="mt-8 text-xs leading-relaxed text-slate-600">{t(locale, "disclaimer")}</p>
</BaseLayout>
