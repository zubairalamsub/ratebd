---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaleBadge from "../components/StaleBadge.astro";
import { CORRIDORS, LISTED_PROVIDERS, REGIONS, amountsFor, loadSnapshot, postedRowsFor, rowsFor, topRows } from "../lib/data";
import { dateTime, list, money, percent, rate, sendAmount } from "../i18n/format";
import { corridorPath, localePath, providerPath } from "../i18n/routes";
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const cards = CORRIDORS.map((corridor) => {
  const amount = amountsFor(corridor.id)[0] ?? 0;
  const rows = rowsFor(corridor.id, amount);
  const top = topRows(rows);
  const best = top[0] ?? rows[0];
  const posted = postedRowsFor(corridor.id);
  return {
    corridor,
    amount,
    snapshot: loadSnapshot(corridor.id),
    best,
    // Providers tied at the same price are named together.
    bestNames:
      best && top.length > 1 && top.every((r) => r.quote.rate === best.quote.rate && r.quote.fee === best.quote.fee)
        ? list(locale, top.map((r) => r.provider.name))
        : best?.provider.name,
    // Shown when a route has no quotes at all.
    bestPosted: posted.find((r) => !r.posted.stale) ?? posted[0],
  };
});
const groups = REGIONS.map((region) => ({ region, cards: cards.filter((c) => c.corridor.region === region) })).filter(
  (g) => g.cards.length > 0,
);
const title = t(locale, "home.title");
const description = t(locale, "home.description");
const site = Astro.site!;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: t(locale, "site.name"),
    url: new URL(localePath(locale, "/"), site).href,
    inLanguage: locale,
    description,
  },
];
---

<BaseLayout locale={locale} title={title} description={description} path="/" jsonLd={jsonLd}>
  <h1 class="max-w-3xl text-3xl sm:text-4xl">{title}</h1>
  <p class="mt-4 max-w-3xl text-lg text-slate-700">{t(locale, "home.lead")}</p>

  <h2 id="routes" class="mt-10 text-xl">{t(locale, "home.routes")}</h2>
  {
    groups.map((group) => (
      <section aria-labelledby={`region-${group.region}`} class="mt-6">
        <h3 id={`region-${group.region}`} class="text-sm font-semibold uppercase tracking-wide text-slate-600">
          {t(locale, group.region)}
        </h3>
        <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            group.cards.map(({ corridor, amount, snapshot, best, bestNames, bestPosted }) => (
              <section class="flex flex-col rounded-xl border border-slate-200 p-5 shadow-sm" aria-labelledby={`card-${corridor.id}`}>
                <h4 id={`card-${corridor.id}`} class="text-lg font-semibold">
                  {t(locale, "home.from", { country: t(locale, corridor.countryKey) })}
                  <span class="ml-1 font-normal text-slate-600">({corridor.sendCurrency} → BDT)</span>
                </h4>
                {best ? (
                  <dl class="mt-3">
                    <dt class="text-sm text-slate-600">
                      {t(locale, best.quote.stale ? "home.bestForStale" : "home.bestFor", {
                        amount: sendAmount(locale, amount, corridor.sendCurrency),
                      })}
                    </dt>
                    <dd class="mt-1 text-2xl font-semibold text-brand-800 tabular">
                      {money(locale, best.quote.receiveAmount, "BDT")}
                    </dd>
                    <dd class="flex flex-wrap items-center gap-2 text-sm text-slate-700">
                      {bestNames}
                      {best.quote.stale && <StaleBadge locale={locale} name={best.provider.name} fetchedAt={best.quote.fetchedAt} />}
                      {best.marginPct !== null && best.marginPct >= 0 && (
                        <span class="text-slate-600"> · {t(locale, "table.margin")}: {percent(locale, best.marginPct)}</span>
                      )}
                    </dd>
                  </dl>
                ) : bestPosted ? (
                  <dl class="mt-3">
                    <dt class="text-sm text-slate-600">
                      {t(locale, bestPosted.posted.stale ? "home.bestPostedStale" : "home.bestPosted")}
                    </dt>
                    <dd class="mt-1 text-2xl font-semibold text-brand-800 tabular">
                      {t(locale, "posted.rateValue", { from: corridor.sendCurrency, rate: rate(locale, bestPosted.posted.rate) })}
                    </dd>
                    <dd class="flex flex-wrap items-center gap-2 text-sm text-slate-700">
                      {bestPosted.posted.partner ?? bestPosted.provider.name}
                      {bestPosted.posted.stale && (
                        <StaleBadge locale={locale} name={bestPosted.provider.name} fetchedAt={bestPosted.posted.fetchedAt} />
                      )}
                    </dd>
                  </dl>
                ) : (
                  <p class="mt-3 text-slate-600">{t(locale, "home.noQuotes")}</p>
                )}
                <p class="mt-2 text-xs text-slate-600">
                  <time datetime={snapshot.generatedAt}>{t(locale, "updated.label", { date: dateTime(locale, snapshot.generatedAt) })}</time>
                </p>
                <a
                  href={localePath(locale, corridorPath(corridor.from))}
                  class="mt-4 inline-flex min-h-11 items-center justify-center rounded-md bg-brand-700 px-4 font-semibold text-white no-underline hover:bg-brand-800"
                >
                  {t(locale, "home.compare")}
                  <span class="sr-only">: {corridor.sendCurrency} → BDT</span>
                </a>
              </section>
            ))
          }
        </div>
      </section>
    ))
  }

  <section class="mt-12" aria-labelledby="why-heading">
    <h2 id="why-heading" class="text-xl">{t(locale, "home.why.title")}</h2>
    <ul class="mt-3 list-disc space-y-1 pl-6 text-slate-700">
      <li>{t(locale, "home.why.1")}</li>
      <li>{t(locale, "home.why.2")}</li>
      <li>{t(locale, "home.why.3")}</li>
    </ul>
    <p class="mt-4">
      <a href={localePath(locale, "/how-rates-work")}>{t(locale, "nav.howRatesWork")}</a> ·
      <a href={localePath(locale, "/government-incentive")}>{t(locale, "nav.incentive")}</a>
    </p>
  </section>

  <section class="mt-12" aria-labelledby="providers-heading">
    <h2 id="providers-heading" class="text-xl">{t(locale, "provider.allTitle")}</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        LISTED_PROVIDERS.map((p) => (
          <li>
            <a
              href={localePath(locale, providerPath(p.slug))}
              class="inline-flex min-h-11 items-center rounded-full border border-slate-300 px-4 text-slate-800 no-underline hover:border-brand-700"
            >
              {p.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
