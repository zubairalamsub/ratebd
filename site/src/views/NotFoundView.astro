---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CORRIDORS } from "../lib/data";
import { corridorPath, localePath } from "../i18n/routes";
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout locale={locale} title={t(locale, "notFound.title")} description={t(locale, "home.description")} path="/404" errorPage>
  <h1 class="text-2xl">{t(locale, "notFound.title")}</h1>
  <p class="mt-3 text-slate-700">{t(locale, "notFound.body")}</p>
  <ul class="mt-3 list-disc pl-6">
    {
      CORRIDORS.map((c) => (
        <li>
          <a href={localePath(locale, corridorPath(c.from))}>{c.sendCurrency} → BDT</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
