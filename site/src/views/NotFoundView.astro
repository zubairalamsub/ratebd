---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CORRIDORS } from "../lib/data";
import { corridorPath, localePath } from "../i18n/routes";
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout locale={locale} title={t(locale, "notFound.title")} description={t(locale, "home.description")} path="/404" errorPage>
  <div class="rounded-2xl bg-gradient-to-br from-brand-50 to-white px-5 py-8 ring-1 ring-brand-100 sm:px-10">
    <p class="text-sm font-semibold text-brand-700">404</p>
    <h1 class="mt-1 text-2xl sm:text-3xl">{t(locale, "notFound.title")}</h1>
    <p class="mt-3 text-slate-700">{t(locale, "notFound.body")}</p>
    <ul class="mt-5 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-5">
      {
        CORRIDORS.map((c) => (
          <li>
            <a
              href={localePath(locale, corridorPath(c.from))}
              class="flex min-h-11 items-center justify-between gap-2 rounded-lg border border-slate-200 bg-white px-3 text-sm text-slate-800 no-underline hover:border-brand-700"
            >
              {t(locale, c.countryKey)} <span class="text-xs text-slate-600">{c.sendCurrency}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
