---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sparkline from "../components/Sparkline.astro";
import StaleBadge from "../components/StaleBadge.astro";
import {
  CORRIDORS,
  PROVIDERS,
  amountsFor,
  loadSnapshot,
  marginPct,
  postedTrendFor,
  statusFor,
  trendFor,
  windowEnd,
} from "../lib/data";
import { date, dateTime, integer, list, money, percent, rate, sendAmount } from "../i18n/format";
import { feeNote, isUnspecified, label } from "../i18n/labels";
import { corridorPath, goPath, localePath, providerPath } from "../i18n/routes";
import { t, type Locale, type UiKey } from "../i18n/ui";

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const provider = PROVIDERS.find((p) => p.slug === slug)!;
const path = providerPath(slug);
const title = t(locale, "provider.title", { name: provider.name });
// Routes the provider was run on. Providers collected only from some countries have no status elsewhere.
const routes = CORRIDORS.filter((corridor) => statusFor(corridor.id, provider.engineName) !== undefined).map((corridor) => {
  const snapshot = loadSnapshot(corridor.id);
  const quotes = snapshot.quotes
    .filter((q) => q.provider === provider.engineName)
    .sort((a, b) => b.sendAmount - a.sendAmount);
  const posted = (snapshot.postedRates ?? []).filter((r) => r.provider === provider.engineName).sort((a, b) => b.rate - a.rate);
  const headlineAmount = amountsFor(corridor.id)[0] ?? 0;
  const history = trendFor(corridor.id, provider.engineName, headlineAmount);
  const rateHistory = postedTrendFor(corridor.id, provider.engineName);
  return { corridor, snapshot, quotes, posted, history, rateHistory, headlineAmount, status: statusFor(corridor.id, provider.engineName) };
});
// An exchange house that only posts rates (no fee) is described as such.
const postsRates = CORRIDORS.some((c) => (loadSnapshot(c.id).postedRateProviders ?? []).some((s) => s.name === provider.engineName));
// Ooredoo Money gives a fee range ("Starting from QAR 20") rather than no fee at all.
const givesFeeRange = routes.some((r) => r.posted.some((p) => p.feeNote));
// Only name the routes the provider actually serves (a provider that merely failed today still counts).
const servedCountries = routes.filter((r) => r.status?.status !== "not_supported").map((r) => t(locale, r.corridor.countryKey));
const description = postsRates
  ? t(locale, "provider.descriptionPosted", { name: provider.name, countries: list(locale, servedCountries) })
  : servedCountries.length > 3
    ? t(locale, "provider.descriptionMany", { name: provider.name, n: integer(locale, servedCountries.length) })
    : t(locale, "provider.description", {
        name: provider.name,
        countries: list(locale, servedCountries),
      });
const th = "px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-slate-600 whitespace-nowrap";
const td = "px-3 py-2 whitespace-nowrap";
---

<BaseLayout locale={locale} title={title} description={description} path={path}>
  <div class="rounded-2xl bg-gradient-to-br from-brand-50 to-white px-5 py-6 ring-1 ring-brand-100 sm:px-8 sm:py-8">
    <h1 class="text-2xl sm:text-3xl">{title}</h1>
    <p class="mt-3 max-w-3xl text-slate-700">{t(locale, givesFeeRange ? "provider.leadPostedRange" : postsRates ? "provider.leadPosted" : "provider.lead", { name: provider.name })}</p>
    <p class="mt-4 flex flex-wrap items-center gap-3">
      <a
        href={goPath(provider.slug)}
        rel="nofollow sponsored noopener"
        class="inline-flex min-h-11 items-center rounded-lg bg-brand-700 px-4 font-semibold text-white no-underline hover:bg-brand-800"
        >{t(locale, "table.visit", { name: provider.name })}</a
      >
      <span class="text-sm text-slate-600">{list(locale, routes.filter((r) => r.status?.status !== "not_supported").map((r) => r.corridor.sendCurrency))}</span>
    </p>
  </div>

  {
    routes.map(({ corridor, snapshot, quotes, posted, history, rateHistory, headlineAmount, status }) => (
      <section class="mt-6 rounded-2xl border border-slate-200 p-4 sm:p-6" aria-labelledby={`route-${corridor.id}`}>
        <h2 id={`route-${corridor.id}`} class="text-xl">
          {t(locale, "home.from", { country: t(locale, corridor.countryKey) })}
          <span class="ml-1 font-normal text-slate-600">({t(locale, "provider.route", { from: corridor.sendCurrency })})</span>
        </h2>

        {status?.status === "not_supported" && (
          <p class="mt-2 text-slate-700">
            {t(locale, "provider.notSupported", { reason: "" })}
            <span lang="en">{status.message}</span>
          </p>
        )}
        {status?.status === "failed" && <p class="mt-2 text-slate-700">{t(locale, "provider.failed")}</p>}

        {quotes.length > 0 && (
          <>
            <ul class="mt-3 grid gap-3 sm:grid-cols-2 md:hidden">
              {quotes.map((q) => {
                const m = marginPct(q, snapshot.midMarket?.rate);
                return (
                  <li class:list={["rounded-xl border border-slate-200 p-4", q.stale && "text-slate-600"]}>
                    <p class="flex flex-wrap items-center justify-between gap-2">
                      <span class="font-semibold text-slate-900">{sendAmount(locale, q.sendAmount, corridor.sendCurrency)}</span>
                      {q.stale && <StaleBadge locale={locale} name={provider.name} fetchedAt={q.fetchedAt} />}
                    </p>
                    <p class="mt-2 tabular">
                      <span class="block text-xs text-slate-600">{t(locale, "table.receive")}</span>
                      <span class="text-xl font-bold text-slate-900">{money(locale, q.receiveAmount, "BDT")}</span>
                    </p>
                    <dl class="mt-2 grid grid-cols-3 gap-2 border-t border-slate-200 pt-2 text-sm tabular">
                      <div>
                        <dt class="text-xs text-slate-600">{t(locale, "table.rate")}</dt>
                        <dd class="font-medium">{rate(locale, q.rate)}</dd>
                      </div>
                      <div>
                        <dt class="text-xs text-slate-600">{t(locale, "table.fee")}</dt>
                        <dd class="font-medium">{money(locale, q.fee, corridor.sendCurrency)}</dd>
                      </div>
                      <div>
                        <dt class="text-xs text-slate-600">{t(locale, "margin.short")}</dt>
                        <dd class:list={["font-medium", m !== null && m < 0 && "text-brand-700"]}>
                          {m === null ? "–" : m < 0 ? t(locale, "margin.betterShort", { value: percent(locale, -m) }) : percent(locale, m)}
                        </dd>
                      </div>
                    </dl>
                    <p class="mt-2 text-sm text-slate-700">
                      {label(locale, q.deliveryMethod)}
                      <span aria-hidden="true"> · </span>
                      {label(locale, q.speed)}
                    </p>
                  </li>
                );
              })}
            </ul>
            <div class="relative mt-3 hidden overflow-x-auto rounded-lg border border-slate-200 md:block" role="region" tabindex="0"
              aria-label={`${provider.name} ${corridor.sendCurrency} → BDT`}>
              <table class="min-w-full divide-y divide-slate-200 text-sm tabular">
                <caption class="sr-only">{provider.name} {corridor.sendCurrency} → BDT</caption>
                <thead class="bg-slate-50">
                  <tr>
                    <th scope="col" class={th}>{t(locale, "corridor.amount")}</th>
                    <th scope="col" class:list={[th, "text-right"]}>{t(locale, "table.rate")}</th>
                    <th scope="col" class:list={[th, "text-right"]}>{t(locale, "table.fee")}</th>
                    <th scope="col" class:list={[th, "text-right"]}>{t(locale, "table.receive")}</th>
                    <th scope="col" class:list={[th, "text-right"]}>{t(locale, "table.margin")}</th>
                    <th scope="col" class={th}>{t(locale, "table.delivery")}</th>
                    <th scope="col" class={th}>{t(locale, "table.speed")}</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {quotes.map((q) => {
                    const m = marginPct(q, snapshot.midMarket?.rate);
                    return (
                      <tr>
                        <th scope="row" class:list={[td, "text-left font-medium"]}>
                          <span class="flex items-center gap-2">
                            {sendAmount(locale, q.sendAmount, corridor.sendCurrency)}
                            {q.stale && <StaleBadge locale={locale} name={provider.name} fetchedAt={q.fetchedAt} />}
                          </span>
                        </th>
                        <td class:list={[td, "text-right"]}>{rate(locale, q.rate)}</td>
                        <td class:list={[td, "text-right"]}>{money(locale, q.fee, corridor.sendCurrency)}</td>
                        <td class:list={[td, "text-right font-semibold"]}>{money(locale, q.receiveAmount, "BDT")}</td>
                        <td class:list={[td, "text-right"]}>
                          {m === null ? "–" : m < 0 ? t(locale, "margin.better", { value: percent(locale, -m) }) : percent(locale, m)}
                        </td>
                        <td class:list={[td, isUnspecified(q.deliveryMethod) && "text-slate-600"]}>{label(locale, q.deliveryMethod)}</td>
                        <td class:list={[td, isUnspecified(q.speed) && "text-slate-600"]}>{label(locale, q.speed)}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
            <p class="mt-2 text-xs text-slate-600">
              {t(locale, "updated.label", { date: dateTime(locale, snapshot.generatedAt) })}
            </p>

            <h3 class="mt-6 text-base">
              {t(locale, "provider.history", { amount: sendAmount(locale, headlineAmount, corridor.sendCurrency) })}
            </h3>
            <div class="mt-2 flex flex-wrap items-start gap-6">
              <Sparkline locale={locale} name={provider.name} points={history} end={windowEnd(corridor.id)} />
              <table class="text-sm tabular">
                <caption class="sr-only">
                  {t(locale, "provider.history", { amount: sendAmount(locale, headlineAmount, corridor.sendCurrency) })}
                </caption>
                <thead>
                  <tr>
                    <th scope="col" class="pr-6 text-left font-semibold text-slate-600">{t(locale, "provider.date")}</th>
                    <th scope="col" class="text-right font-semibold text-slate-600">{t(locale, "table.receive")}</th>
                  </tr>
                </thead>
                <tbody>
                  {history.map((h) => (
                    <tr class:list={[h.stale && "text-slate-600"]}>
                      <td class="pr-6">{date(locale, h.date)}</td>
                      <td class="text-right">
                        {h.value === null ? "–" : money(locale, h.value, "BDT")}
                        {h.stale && (
                          <span class="ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-900">
                            {t(locale, "badge.stale")}
                          </span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )}

        {posted.length > 0 && (
          <>
            <ul class="mt-3 divide-y divide-slate-100 rounded-xl border border-slate-200 md:hidden">
              {posted.map((r) => (
                <li class:list={["flex items-start justify-between gap-3 p-4", r.stale && "text-slate-600"]}>
                  <div class="min-w-0">
                    {r.partner && <p class="font-medium text-slate-900">{r.partner}</p>}
                    <p class="text-sm text-slate-700">
                      {t(locale, "table.fee")}: {r.feeNote ? feeNote(locale, r.feeNote) : t(locale, "posted.feeNone")}
                      <span aria-hidden="true"> · </span>
                      {label(locale, r.deliveryMethod)}
                      {!isUnspecified(r.speed) && (
                        <>
                          <span aria-hidden="true"> · </span>
                          {label(locale, r.speed)}
                        </>
                      )}
                    </p>
                    {r.stale && (
                      <div class="mt-1">
                        <StaleBadge locale={locale} name={provider.name} fetchedAt={r.fetchedAt} />
                      </div>
                    )}
                  </div>
                  <p class="shrink-0 text-right tabular">
                    <span class="block text-xs text-slate-600">{t(locale, "table.rate")}</span>
                    <span class="text-lg font-bold text-slate-900">{rate(locale, r.rate)}</span>
                  </p>
                </li>
              ))}
            </ul>
            <div class="relative mt-3 hidden overflow-x-auto rounded-lg border border-slate-200 md:block" role="region" tabindex="0"
              aria-label={`${provider.name} ${corridor.sendCurrency} → BDT`}>
              <table class="min-w-full divide-y divide-slate-200 text-sm tabular">
                <caption class="sr-only">{provider.name} {corridor.sendCurrency} → BDT</caption>
                <thead class="bg-slate-50">
                  <tr>
                    {posted.some((r) => r.partner) && <th scope="col" class={th}>{t(locale, "posted.house")}</th>}
                    <th scope="col" class:list={[th, "text-right"]}>{t(locale, "table.rate")}</th>
                    <th scope="col" class={th}>{t(locale, "table.fee")}</th>
                    <th scope="col" class={th}>{t(locale, "table.delivery")}</th>
                    <th scope="col" class={th}>{t(locale, "table.speed")}</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {posted.map((r) => (
                    <tr>
                      {posted.some((x) => x.partner) && (
                        <th scope="row" class:list={[td, "text-left font-medium"]}>{r.partner}</th>
                      )}
                      <td class:list={[td, "text-right font-semibold"]}>
                        <span class="inline-flex items-center gap-2">
                          {rate(locale, r.rate)}
                          {r.stale && <StaleBadge locale={locale} name={provider.name} fetchedAt={r.fetchedAt} />}
                        </span>
                      </td>
                      <td class:list={[td, !r.feeNote && "text-slate-600"]}>
                        {r.feeNote ? feeNote(locale, r.feeNote) : t(locale, "posted.feeNone")}
                      </td>
                      <td class:list={[td, isUnspecified(r.deliveryMethod) && "text-slate-600"]}>{label(locale, r.deliveryMethod)}</td>
                      <td class:list={[td, isUnspecified(r.speed) && "text-slate-600"]}>{label(locale, r.speed)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="mt-2 text-xs text-slate-600">
              {t(locale, "updated.label", { date: dateTime(locale, snapshot.generatedAt) })}
            </p>

            <h3 class="mt-6 text-base">{t(locale, "provider.rateHistory")}</h3>
            <div class="mt-2 flex flex-wrap items-start gap-6">
              <Sparkline locale={locale} name={provider.name} points={rateHistory} end={windowEnd(corridor.id)} kind="rate" />
              <table class="text-sm tabular">
                <caption class="sr-only">{t(locale, "provider.rateHistory")}</caption>
                <thead>
                  <tr>
                    <th scope="col" class="pr-6 text-left font-semibold text-slate-600">{t(locale, "provider.date")}</th>
                    <th scope="col" class="text-right font-semibold text-slate-600">{t(locale, "table.rate")}</th>
                  </tr>
                </thead>
                <tbody>
                  {rateHistory.map((h) => (
                    <tr class:list={[h.stale && "text-slate-600"]}>
                      <td class="pr-6">{date(locale, h.date)}</td>
                      <td class="text-right">
                        {h.value === null ? "–" : rate(locale, h.value)}
                        {h.stale && (
                          <span class="ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-900">
                            {t(locale, "badge.stale")}
                          </span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )}

        <p class="mt-4 text-sm">
          <a href={localePath(locale, corridorPath(corridor.from))}>
            {t(locale, "provider.compare", { country: t(locale, corridor.countryKey) })}
          </a>
        </p>
      </section>
    ))
  }

  <section class="mt-10" aria-labelledby="source-heading">
    <h2 id="source-heading" class="text-xl">{t(locale, "provider.source")}</h2>
    <p class="mt-2 max-w-3xl text-slate-700">{t(locale, `source.${provider.engineName}` as UiKey)}</p>
  </section>

  <p class="mt-8 text-xs leading-relaxed text-slate-600">{t(locale, "disclaimer")}</p>
</BaseLayout>
