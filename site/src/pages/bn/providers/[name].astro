---
import ProviderView from "../../../views/ProviderView.astro";
import { LISTED_PROVIDERS } from "../../../lib/data";

export function getStaticPaths() {
  return LISTED_PROVIDERS.map((p) => ({ params: { name: p.slug } }));
}

const { name } = Astro.params;
---

<ProviderView locale="bn" slug={name!} />
