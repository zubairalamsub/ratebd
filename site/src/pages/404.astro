---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CORRIDORS } from "../lib/data";
import { corridorPath } from "../i18n/routes";
import { t } from "../i18n/ui";
---

<BaseLayout locale="en" title={t("en", "notFound.title")} description={t("en", "home.description")} path="/404">
  <h1 class="text-2xl">{t("en", "notFound.title")}</h1>
  <p class="mt-3 text-slate-700">{t("en", "notFound.body")}</p>
  <ul class="mt-3 list-disc pl-6">
    {
      CORRIDORS.map((c) => (
        <li>
          <a href={corridorPath(c.from)}>{c.sendCurrency} → BDT</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
