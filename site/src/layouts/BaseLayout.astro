---
import "../styles/global.css";
import { CORRIDORS, REGIONS, lastUpdated } from "../lib/data";
import { dateTime } from "../i18n/format";
import { corridorPath, localePath } from "../i18n/routes";
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Locale-neutral path of this page, e.g. "/how-rates-work" */
  path: string;
  jsonLd?: object[];
  /** Error pages have no canonical URL or language alternates; the language switch goes to the other home page. */
  errorPage?: boolean;
}

const { locale, title, description, path, jsonLd = [], errorPage = false } = Astro.props;
const site = Astro.site!;
const url = (l: Locale) => new URL(localePath(l, path), site).href;
const canonical = url(locale);
const other: Locale = locale === "en" ? "bn" : "en";
const fullTitle = path === "/" ? `${t(locale, "site.name")}: ${title}` : `${title} | ${t(locale, "site.name")}`;
const ogImage = new URL("/og.png", site).href;
const updated = lastUpdated();
const nav = [
  { href: localePath(locale, "/"), text: t(locale, "nav.routes") },
  { href: localePath(locale, "/how-rates-work"), text: t(locale, "nav.howRatesWork") },
  { href: localePath(locale, "/government-incentive"), text: t(locale, "nav.incentive") },
];
const current = localePath(locale, path);
const switchHref = errorPage ? localePath(other, "/") : localePath(other, path);
---

<!doctype html>
<html lang={locale === "bn" ? "bn-BD" : "en-GB"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {
      errorPage ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="en" href={url("en")} />
          <link rel="alternate" hreflang="bn" href={url("bn")} />
          <link rel="alternate" hreflang="x-default" href={url("en")} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#005c41" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(locale, "site.name")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!errorPage && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t(locale, "site.tagline")} />
    <meta property="og:locale" content={locale === "bn" ? "bn_BD" : "en_GB"} />
    <meta property="og:locale:alternate" content={locale === "bn" ? "en_GB" : "bn_BD"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only rounded bg-brand-700 px-4 py-2 text-white no-underline focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-10"
      >{t(locale, "skip")}</a
    >
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 px-4">
        <a href={localePath(locale, "/")} class="flex min-h-14 items-center gap-2 text-lg font-bold text-brand-800 no-underline">
          <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="7" fill="#005c41"></rect>
            <circle cx="14" cy="16" r="7" fill="#c8102e"></circle>
          </svg>
          {t(locale, "site.name")}
        </a>
        <a
          href={switchHref}
          hreflang={other}
          title={t(locale, "lang.switchLabel")}
          class="relative ml-auto inline-flex min-h-11 items-center rounded-full border border-slate-300 px-4 text-sm font-medium text-slate-800 no-underline hover:border-brand-700 md:order-last md:ml-2"
          ><span lang={other === "bn" ? "bn-BD" : "en-GB"}>{t(locale, "lang.switch")}</span><span class="sr-only">
            ({t(locale, "lang.switchLabel")})</span
          ></a
        >
        <!-- Phones: a second row that scrolls sideways instead of wrapping. -->
        <nav
          aria-label={t(locale, "nav.label")}
          class="order-last -mx-4 w-[calc(100%+2rem)] overflow-x-auto border-t border-slate-100 [scrollbar-width:none] md:order-none md:mx-0 md:ml-auto md:w-auto md:border-0 [&::-webkit-scrollbar]:hidden"
        >
          <ul class="flex gap-1 whitespace-nowrap px-2 py-1 text-sm md:px-0">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.href === current ? "page" : undefined}
                    class:list={[
                      "inline-flex min-h-11 items-center rounded-md px-3 no-underline",
                      item.href === current
                        ? "bg-brand-50 font-semibold text-brand-800"
                        : "text-slate-700 hover:bg-slate-100",
                    ]}
                  >
                    {item.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 sm:py-8">
      <slot />
    </main>

    <footer class="mt-12 border-t border-slate-200 bg-slate-50">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 text-sm text-slate-600 sm:grid-cols-2 lg:grid-cols-4">
        <div class="lg:col-span-2">
          <p class="flex items-center gap-2 text-base font-bold text-brand-800">
            <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true">
              <rect width="32" height="32" rx="7" fill="#005c41"></rect>
              <circle cx="14" cy="16" r="7" fill="#c8102e"></circle>
            </svg>
            {t(locale, "site.name")}
          </p>
          <p class="mt-2 max-w-md">{t(locale, "site.tagline")}.</p>
          <p class="mt-3 max-w-md">
            {t(locale, "footer.data")}
            {t(locale, "updated.label", { date: dateTime(locale, updated) })}{locale === "bn" ? "।" : "."}
          </p>
        </div>
        <nav aria-label={t(locale, "footer.routes")}>
          <h2 class="text-sm font-semibold text-slate-900">{t(locale, "footer.routes")}</h2>
          <ul class="mt-3 grid grid-cols-2 gap-x-4 sm:grid-cols-1">
            {
              REGIONS.flatMap((region) => CORRIDORS.filter((c) => c.region === region)).map((c) => (
                <li>
                  <a href={localePath(locale, corridorPath(c.from))} class="inline-flex min-h-8 items-center text-slate-700">
                    {t(locale, c.countryKey)} · {c.sendCurrency}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <nav aria-label={t(locale, "footer.about")}>
          <h2 class="text-sm font-semibold text-slate-900">{t(locale, "footer.about")}</h2>
          <ul class="mt-3">
            <li><a href={localePath(locale, "/how-rates-work")} class="inline-flex min-h-8 items-center text-slate-700">{t(locale, "nav.howRatesWork")}</a></li>
            <li><a href={localePath(locale, "/government-incentive")} class="inline-flex min-h-8 items-center text-slate-700">{t(locale, "nav.incentive")}</a></li>
            <li><a href="https://github.com/zubairalamsub/ratebd" class="inline-flex min-h-8 items-center text-slate-700">{t(locale, "footer.source")}</a></li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
