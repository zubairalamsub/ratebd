---
import "../styles/global.css";
import { lastUpdated } from "../lib/data";
import { dateTime } from "../i18n/format";
import { localePath } from "../i18n/routes";
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Locale-neutral path of this page, e.g. "/how-rates-work" */
  path: string;
  jsonLd?: object[];
  /** Error pages have no canonical URL or language alternates; the language switch goes to the other home page. */
  errorPage?: boolean;
}

const { locale, title, description, path, jsonLd = [], errorPage = false } = Astro.props;
const site = Astro.site!;
const url = (l: Locale) => new URL(localePath(l, path), site).href;
const canonical = url(locale);
const other: Locale = locale === "en" ? "bn" : "en";
const fullTitle = path === "/" ? `${t(locale, "site.name")}: ${title}` : `${title} | ${t(locale, "site.name")}`;
const ogImage = new URL("/og.png", site).href;
const updated = lastUpdated();
const nav = [
  { href: localePath(locale, "/"), text: t(locale, "nav.routes") },
  { href: localePath(locale, "/how-rates-work"), text: t(locale, "nav.howRatesWork") },
  { href: localePath(locale, "/government-incentive"), text: t(locale, "nav.incentive") },
];
const current = localePath(locale, path);
const switchHref = errorPage ? localePath(other, "/") : localePath(other, path);
---

<!doctype html>
<html lang={locale === "bn" ? "bn-BD" : "en-GB"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {
      errorPage ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="en" href={url("en")} />
          <link rel="alternate" hreflang="bn" href={url("bn")} />
          <link rel="alternate" hreflang="x-default" href={url("en")} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#005c41" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(locale, "site.name")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!errorPage && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t(locale, "site.tagline")} />
    <meta property="og:locale" content={locale === "bn" ? "bn_BD" : "en_GB"} />
    <meta property="og:locale:alternate" content={locale === "bn" ? "en_GB" : "bn_BD"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only rounded bg-brand-700 px-4 py-2 text-white no-underline focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-10"
      >{t(locale, "skip")}</a
    >
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3">
        <a href={localePath(locale, "/")} class="flex items-center gap-2 text-lg font-bold text-brand-800 no-underline">
          <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="7" fill="#005c41"></rect>
            <circle cx="14" cy="16" r="7" fill="#c8102e"></circle>
          </svg>
          {t(locale, "site.name")}
        </a>
        <a
          href={switchHref}
          hreflang={other}
          title={t(locale, "lang.switchLabel")}
          class="relative inline-flex min-h-11 items-center rounded-full border border-slate-300 px-4 text-sm font-medium text-slate-800 no-underline hover:border-brand-700"
          ><span lang={other === "bn" ? "bn-BD" : "en-GB"}>{t(locale, "lang.switch")}</span><span class="sr-only">
            ({t(locale, "lang.switchLabel")})</span
          ></a
        >
        <nav aria-label={t(locale, "nav.label")} class="w-full sm:w-auto">
          <ul class="flex flex-wrap gap-x-1 gap-y-1 text-sm">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.href === current ? "page" : undefined}
                    class:list={[
                      "inline-flex min-h-11 items-center rounded-md px-3 no-underline",
                      item.href === current
                        ? "bg-brand-50 font-semibold text-brand-800"
                        : "text-slate-700 hover:bg-slate-100",
                    ]}
                  >
                    {item.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-5xl space-y-2 px-4 py-6 text-sm text-slate-600">
        <p>{t(locale, "footer.data")} {t(locale, "updated.label", { date: dateTime(locale, updated) })}{locale === "bn" ? "।" : "."}</p>
        <p>
          <a href="https://github.com/zubairalamsub/ratebd">{t(locale, "footer.source")}</a>
        </p>
      </div>
    </footer>
  </body>
</html>
